# Server
PORT=3005
APP_ENV=development
LOG_LEVEL=info

# Database
# MySQL default port: 3306 | PostgreSQL default port: 5432
# Driver is set at compile time via Cargo features: --features mysql (default) or --features postgres
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password
DB_MAX_CONNECTIONS=10

# JWT
JWT_SECRET=change-me-to-a-secure-random-string
JWT_EXPIRATION=900
REFRESH_TOKEN_EXPIRATION=2592000

# CORS
CORS_ORIGINS=http://localhost:3004,http://localhost:3005

# Upload
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=10485760

# CDN
CDN_URL=http://cdn.localhost/

# Site
SITE_NAME=MySite.com
SITE_URL=http://localhost:3000
BASE_URL=http://localhost:3000/

# Mail
MAIL_FROM=contact@example.com
SMTP_HOST=localhost
SMTP_PORT=465
SMTP_USER=smtp@example.com
SMTP_PASSWORD=your_smtp_password
