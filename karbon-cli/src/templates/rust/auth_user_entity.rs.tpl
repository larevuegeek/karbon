use serde::{Deserialize, Serialize};
use sqlx::FromRow;

use karbon::db::CrudRepository;

/// An account that can sign in. Generated by `karbon generate auth` — this file is yours.
#[derive(Debug, Clone, Serialize, Deserialize, FromRow)]
pub struct User {
    pub id: i64,
    pub email: String, // karbon:unique
    /// Argon2id hash of the password. Never serialized: `Json(user)` cannot leak it.
    #[serde(skip_serializing)]
    pub password: String,
    /// Role names separated by commas: `ROLE_USER`, or `ROLE_USER,ROLE_ADMIN`.
    pub roles: String,
    pub created: chrono::NaiveDateTime,
    pub updated: chrono::NaiveDateTime,
}

impl User {
    /// The roles as the access token carries them.
    pub fn role_list(&self) -> Vec<String> {
        self.roles.split(',').map(str::trim).filter(|role| !role.is_empty()).map(String::from).collect()
    }
}

impl CrudRepository for User {
    const TABLE: &'static str = "users";
    const ENTITY_NAME: &'static str = "User";
}

/// DTO for inserting a new User. `password` is the hash, never the password itself.
#[derive(Debug, karbon::Insertable)]
#[table_name("users")]
pub struct NewUser {
    pub email: String,
    pub password: String,
    pub roles: String,
}

/// DTO for updating a User: only the `Some` fields change.
#[derive(Debug, Default, karbon::Updatable)]
#[table_name("users")]
pub struct UpdateUser {
    #[primary_key]
    pub id: i64,
    pub password: Option<String>,
    pub roles: Option<String>,
}
