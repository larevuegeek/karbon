//! Accounts, sessions and password resets — the logic behind `controller/auth_controller.rs`.
//! Generated by `karbon generate auth` — this file is yours.
//!
//! A session is two tokens:
//! - an **access token** (a JWT, `JWT_EXPIRATION` seconds — 15 minutes by default) that
//!   `AuthGuard` verifies on every request, without touching the database;
//! - a **refresh token** (random, `REFRESH_TOKEN_EXPIRATION` seconds — 30 days by default)
//!   stored hashed in `auth_tokens`, which buys a new access token when the old one has
//!   expired. It is replaced each time it is used, and deleting it ends the session.

use chrono::{Duration, Utc};

use karbon::db::{CrudRepository, DbPool, DeleteBuilder};
use karbon::error::{AppError, AppResult};
use karbon::http::AppState;
use karbon::security::{Crypto, JwtManager, Password, anti_timing_delay};
use karbon::validation::constraints::Constraint;
use karbon::validation::constraints::security::Password as PasswordRule;
use karbon::validation::constraints::string::Email;

use crate::entity::auth_token::{AuthToken, NewAuthToken};
use crate::entity::user::{NewUser, UpdateUser, User};

/// Role given to every new account. For an administrator: `karbon user create --admin`.
pub const DEFAULT_ROLE: &str = "ROLE_USER";
/// One message for an unknown email and for a wrong password: it must not tell which.
pub const BAD_CREDENTIALS: &str = "Invalid email or password";
pub const PASSWORD_HINT: &str = "At least 8 characters, with a lowercase letter, an uppercase letter and a digit.";
/// What is answered to a reset request, whether the email has an account or not.
pub const RESET_REQUESTED: &str = "If an account exists for this email, a link to choose a new password is on its way.";
pub const BAD_RESET_LINK: &str = "This link is invalid or has expired. Ask for a new one.";

/// How long a password-reset link works, in seconds.
const RESET_SECONDS: i64 = 3600;
const REFRESH: &str = "refresh";
const RESET: &str = "reset";

/// What a signed-in client holds.
pub struct Session {
    pub access_token: String,
    /// Seconds until the access token expires.
    pub expires_in: i64,
    pub refresh_token: String,
    /// Seconds until the refresh token expires.
    pub refresh_expires_in: i64,
}

// ─── Accounts ───

/// Checks an email and a password, and returns the account they open.
pub async fn authenticate(pool: &DbPool, email: &str, password: &str) -> AppResult<User> {
    let user = User::find_where(pool, &[("email", normalize(email).into())]).await?;

    let verified = match &user {
        Some(user) => Password::verify(password, &user.password).unwrap_or(false),
        None => {
            // Hash anyway. Without it an unknown email answers much faster than a wrong
            // password, and that difference tells which emails have an account.
            let _ = Password::hash(password);
            false
        }
    };
    anti_timing_delay().await;

    match user {
        Some(user) if verified => Ok(user),
        _ => Err(AppError::Unauthorized(BAD_CREDENTIALS.into())),
    }
}

/// Creates an account with [`DEFAULT_ROLE`]. Call [`check_new_account`] first.
pub async fn create_account(pool: &DbPool, email: &str, password: &str) -> AppResult<User> {
    let email = normalize(email);
    if User::find_where(pool, &[("email", email.as_str().into())]).await?.is_some() {
        return Err(AppError::Conflict("An account already exists with this email".into()));
    }

    let hash = hash(password)?;
    let id = NewUser { email, password: hash, roles: DEFAULT_ROLE.into() }.insert(pool).await?;

    User::find_by_id(pool, id as i64)
        .await?
        .ok_or_else(|| AppError::Internal("the account just created was not found".into()))
}

pub fn check_new_account(email: &str, password: &str) -> AppResult<()> {
    Email::new().validate(&normalize(email)).map_err(|v| AppError::Validation(v.message))?;
    check_password(password)
}

pub fn check_password(password: &str) -> AppResult<()> {
    PasswordRule::new().validate(password).map_err(|v| AppError::Validation(v.message))?;
    Ok(())
}

/// Emails are compared without their case or surrounding spaces.
fn normalize(email: &str) -> String {
    email.trim().to_lowercase()
}

fn hash(password: &str) -> AppResult<String> {
    Password::hash(password).map_err(|e| AppError::internal(e, "Could not save the password"))
}

// ─── Sessions ───

/// Opens a session for `user`: a fresh access token and a new refresh token.
pub async fn open_session(state: &AppState, user: &User) -> AppResult<Session> {
    let expires_in = state.config.jwt_expiration;
    let access_token = JwtManager::new(&state.config.jwt_secret, expires_in)
        .generate_full(&user.email, &user.email, user.role_list(), Some(user.id), None, None)
        .map_err(|e| AppError::internal(e, "Could not sign you in: is JWT_SECRET set?"))?;

    let refresh_expires_in = state.config.refresh_token_expiration;
    let refresh_token = store_token(state, user.id, REFRESH, refresh_expires_in).await?;

    Ok(Session { access_token, expires_in, refresh_token, refresh_expires_in })
}

/// Trades a refresh token for a new session. The token is consumed: a refresh token works
/// once, so a stolen copy stops working as soon as the real client renews — or the reverse,
/// which signs the real client out and makes the theft visible.
pub async fn renew_session(state: &AppState, refresh_token: &str) -> AppResult<Session> {
    let expired = || AppError::Unauthorized("This session has expired: sign in again".into());

    let token = take_token(state, refresh_token, REFRESH).await?.ok_or_else(expired)?;
    // The roles are read again: a promotion or a demotion applies at the next renewal.
    let user = User::find_by_id(state.db.pool(), token.user_id).await?.ok_or_else(expired)?;

    open_session(state, &user).await
}

/// Ends the session this refresh token belongs to. Unknown tokens are ignored.
pub async fn close_session(state: &AppState, refresh_token: &str) -> AppResult<()> {
    take_token(state, refresh_token, REFRESH).await?;
    Ok(())
}

/// Ends every session of a user (after a password change).
pub async fn close_all_sessions(pool: &DbPool, user_id: i64) -> AppResult<()> {
    DeleteBuilder::from(AuthToken::TABLE)
        .where_eq("user_id", user_id)
        .where_eq("kind", REFRESH.to_string())
        .execute(pool)
        .await?;
    Ok(())
}

// ─── Password reset ───

/// Emails a reset link to the account behind `email`, if there is one. The caller answers
/// [`RESET_REQUESTED`] either way: this must not reveal which emails have an account.
pub async fn request_password_reset(state: &AppState, email: &str, reset_page: &str) -> AppResult<()> {
    let user = User::find_where(state.db.pool(), &[("email", normalize(email).into())]).await?;

    if let Some(user) = user {
        let token = store_token(state, user.id, RESET, RESET_SECONDS).await?;
        let link = format!("{}{reset_page}?token={token}", state.config.base_url.trim_end_matches('/'));
        send_reset_link(state, user.email, link);
    }

    anti_timing_delay().await;
    Ok(())
}

/// Sets a new password from a reset link, and ends every session of the account: whoever
/// held one before the reset is signed out. Call [`check_password`] first.
pub async fn reset_password(state: &AppState, reset_token: &str, password: &str) -> AppResult<()> {
    let token = take_token(state, reset_token, RESET)
        .await?
        .ok_or_else(|| AppError::BadRequest(BAD_RESET_LINK.into()))?;

    let pool = state.db.pool();
    UpdateUser { id: token.user_id, password: Some(hash(password)?), ..Default::default() }.update(pool).await?;
    close_all_sessions(pool, token.user_id).await
}

/// Sends the link in the background: the response must not take longer for an email that
/// has an account than for one that has none.
fn send_reset_link(state: &AppState, email: String, link: String) {
    let Some(mailer) = state.mailer.clone() else {
        if state.config.is_development() {
            // No SMTP while developing: the link is in the log so the flow can be tried.
            tracing::warn!("No mailer configured (SMTP_HOST) — password reset link for {email}: {link}");
        } else {
            tracing::error!("A password reset was requested but no mailer is configured (SMTP_HOST): nothing was sent");
        }
        return;
    };

    tokio::spawn(async move {
        let body = format!(
            "Hello,\n\nSomeone asked to choose a new password for your account. Open this link to do it:\n\n\
             {link}\n\nIt works once, for one hour. If it was not you, ignore this email: your password is unchanged.\n"
        );
        if let Err(error) = mailer.send_text(&email, "Choose a new password", &body).await {
            tracing::error!(%error, "Could not send the password reset email");
        }
    });
}

// ─── Tokens ───

/// Creates a token and stores its hash. Returns the token itself, which exists nowhere else.
async fn store_token(state: &AppState, user_id: i64, kind: &str, lifetime_seconds: i64) -> AppResult<String> {
    let pool = state.db.pool();
    let now = Utc::now().naive_utc();

    // Housekeeping: tokens nobody can use any more.
    DeleteBuilder::from(AuthToken::TABLE).where_lt("expires", now).execute(pool).await?;

    let token = Crypto::random_token(48);
    NewAuthToken {
        user_id,
        kind: kind.to_string(),
        token_hash: hash_token(state, &token),
        expires: now + Duration::seconds(lifetime_seconds),
    }
    .insert(pool)
    .await?;
    Ok(token)
}

/// Finds a token and deletes it: whatever it was for, it will not work a second time.
/// `None` when it is unknown, of another kind, expired — or just taken by a concurrent request.
async fn take_token(state: &AppState, token: &str, kind: &str) -> AppResult<Option<AuthToken>> {
    let pool = state.db.pool();
    let Some(found) = AuthToken::find_where(pool, &[("token_hash", hash_token(state, token).into())]).await? else {
        return Ok(None);
    };

    let taken = AuthToken::delete(pool, found.id).await? == 1;
    let usable = taken && found.kind == kind && found.expires > Utc::now().naive_utc();
    Ok(usable.then_some(found))
}

/// Keyed with `JWT_SECRET`: the hashes in the database cannot be recomputed without it.
fn hash_token(state: &AppState, token: &str) -> String {
    Crypto::hash_token_keyed(token, state.config.jwt_secret.as_bytes())
}
