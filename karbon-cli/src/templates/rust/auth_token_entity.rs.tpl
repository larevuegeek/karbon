use sqlx::FromRow;

use karbon::db::CrudRepository;

/// A token handed to a user: the refresh token of a session, or a password-reset link.
/// Generated by `karbon generate auth` — this file is yours.
///
/// Only a keyed hash of the token is stored: a copy of this table opens no session.
#[derive(Debug, Clone, FromRow)]
pub struct AuthToken {
    pub id: i64,
    pub user_id: i64,
    /// `refresh` or `reset`.
    pub kind: String,
    pub token_hash: String, // karbon:unique
    pub expires: chrono::NaiveDateTime,
    pub created: chrono::NaiveDateTime,
    pub updated: chrono::NaiveDateTime,
}

impl CrudRepository for AuthToken {
    const TABLE: &'static str = "auth_tokens";
    const ENTITY_NAME: &'static str = "AuthToken";
}

/// DTO for inserting a new AuthToken
#[derive(Debug, karbon::Insertable)]
#[table_name("auth_tokens")]
pub struct NewAuthToken {
    pub user_id: i64,
    pub kind: String,
    pub token_hash: String,
    pub expires: chrono::NaiveDateTime,
}
