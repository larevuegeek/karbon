//! Sign-up, sign-in, sign-out and password reset. Generated by `karbon generate auth` —
//! this file is yours. The logic lives in `service/auth.rs`.
//!
//! Browser pages (session cookies)
//!   GET  /auth/login      · POST /auth/login
//!   GET  /auth/register   · POST /auth/register
//!   GET  /auth/forgot     · POST /auth/forgot      (emails a reset link)
//!   GET  /auth/reset      · POST /auth/reset       (chooses the new password)
//!   GET  /auth/account    · POST /auth/logout
//!   POST /auth/refresh                             (renews the session; called by the pages)
//!
//! JSON API (Bearer token), under the API prefix
//!   POST /auth/login · /auth/register · /auth/refresh   → { "token", "refresh_token", … }
//!   POST /auth/logout · /auth/forgot · /auth/reset
//!   GET  /auth/me
//!
//! First administrator: `karbon user create you@example.com --admin`.

use std::collections::HashMap;

use axum::Json;
use axum::extract::{Form as AxumForm, Query, State};
use axum::http::header::SET_COOKIE;
use axum::http::{HeaderMap, StatusCode};
use axum::response::{AppendHeaders, Html, IntoResponse, Redirect, Response};
use serde::{Deserialize, Serialize};

use karbon::db::CrudRepository;
use karbon::error::{AppError, AppResult};
use karbon::form::{Field, Form};
use karbon::http::AppState;
use karbon::security::auth_cookie::is_https;
use karbon::security::{
    AuthGuard, clear_refresh_cookie, local_redirect, login_cookie, logout_cookie, refresh_cookie, refresh_token_from,
};
use karbon::validation::constraints::security::Password as PasswordRule;
use karbon::validation::constraints::string::Email;

use crate::entity::user::User;
use crate::service::auth::{self, BAD_RESET_LINK, PASSWORD_HINT, RESET_REQUESTED, Session};

const PREFIX: &str = "/auth";
/// Where a browser lands after signing in, unless `?next=` names another page of the site.
const HOME: &str = "/auth/account";

// ─── Browser pages ───

#[derive(Deserialize)]
pub struct NextQuery {
    next: Option<String>,
}

#[derive(Deserialize)]
pub struct ResetQuery {
    token: Option<String>,
}

pub struct AuthController;

#[karbon::controller(prefix = "/auth")]
impl AuthController {
    /// The login form — or, for a browser whose access token has expired but whose session
    /// has not, a silent renewal and a redirect back to the page it wanted.
    #[karbon::get("/login")]
    async fn login_page(
        State(state): State<AppState>,
        headers: HeaderMap,
        Query(query): Query<NextQuery>,
    ) -> AppResult<Response> {
        if let Some(refresh_token) = refresh_token_from(&headers)
            && let Ok(session) = auth::renew_session(&state, refresh_token).await
        {
            return Ok(signed_in(&headers, &session, Redirect::to(&local_redirect(query.next.as_deref(), HOME))));
        }
        Ok(login_view(&login_form(query.next.as_deref()), None))
    }

    #[karbon::post("/login")]
    async fn login(
        State(state): State<AppState>,
        headers: HeaderMap,
        AxumForm(data): AxumForm<HashMap<String, String>>,
    ) -> AppResult<Response> {
        let next = data.get("next").cloned();
        let mut form = login_form(next.as_deref());
        if !form.handle(&data) {
            return Ok(login_view(&form, None));
        }

        let (email, password) = (form.value("email").unwrap_or_default(), form.value("password").unwrap_or_default());
        match auth::authenticate(state.db.pool(), email, password).await {
            Ok(user) => {
                let session = auth::open_session(&state, &user).await?;
                // `next` comes from the query string: `local_redirect` only follows a path of this site.
                Ok(signed_in(&headers, &session, Redirect::to(&local_redirect(next.as_deref(), HOME))))
            }
            Err(AppError::Unauthorized(message)) => Ok(login_view(&form, Some(&message))),
            Err(other) => Err(other),
        }
    }

    #[karbon::get("/register")]
    async fn register_page() -> AppResult<Response> {
        Ok(register_view(&register_form(), None))
    }

    #[karbon::post("/register")]
    async fn register(
        State(state): State<AppState>,
        headers: HeaderMap,
        AxumForm(data): AxumForm<HashMap<String, String>>,
    ) -> AppResult<Response> {
        let mut form = register_form();
        if !form.handle(&data) {
            return Ok(register_view(&form, None));
        }

        let (email, password) = (form.value("email").unwrap_or_default(), form.value("password").unwrap_or_default());
        match auth::create_account(state.db.pool(), email, password).await {
            Ok(user) => {
                let session = auth::open_session(&state, &user).await?;
                Ok(signed_in(&headers, &session, Redirect::to(HOME)))
            }
            Err(AppError::Conflict(message)) => Ok(register_view(&form, Some(&message))),
            Err(other) => Err(other),
        }
    }

    #[karbon::get("/forgot")]
    async fn forgot_page() -> AppResult<Response> {
        Ok(forgot_view(&forgot_form(), None))
    }

    /// Always the same answer: it must not tell whether the email has an account.
    #[karbon::post("/forgot")]
    async fn forgot(
        State(state): State<AppState>,
        AxumForm(data): AxumForm<HashMap<String, String>>,
    ) -> AppResult<Response> {
        let mut form = forgot_form();
        if !form.handle(&data) {
            return Ok(forgot_view(&form, None));
        }
        auth::request_password_reset(&state, form.value("email").unwrap_or_default(), &format!("{PREFIX}/reset")).await?;
        Ok(Html(layout("Check your inbox", &notice(RESET_REQUESTED))).into_response())
    }

    #[karbon::get("/reset")]
    async fn reset_page(Query(query): Query<ResetQuery>) -> AppResult<Response> {
        Ok(reset_view(&reset_form(query.token.as_deref().unwrap_or_default()), None))
    }

    #[karbon::post("/reset")]
    async fn reset(
        State(state): State<AppState>,
        AxumForm(data): AxumForm<HashMap<String, String>>,
    ) -> AppResult<Response> {
        let token = data.get("token").cloned().unwrap_or_default();
        let mut form = reset_form(&token);
        if !form.handle(&data) {
            return Ok(reset_view(&form, None));
        }

        match auth::reset_password(&state, &token, form.value("password").unwrap_or_default()).await {
            Ok(()) => {
                let body = format!(
                    "{}<p><a href=\"{PREFIX}/login\">Sign in</a></p>",
                    notice("Your password has been changed. Every session of this account was signed out.")
                );
                Ok(Html(layout("Password changed", &body)).into_response())
            }
            Err(AppError::BadRequest(message)) => Ok(reset_view(&form, Some(&message))),
            Err(other) => Err(other),
        }
    }

    /// The signed-in user's page. `auth: AuthGuard` is what requires a session: without
    /// one the browser is sent to the login page (`LOGIN_PATH` in `.env`).
    #[karbon::get("/account")]
    async fn account(auth: AuthGuard) -> AppResult<Response> {
        let body = format!(
            "<p>Signed in as <b>{email}</b></p><p>Roles: {roles}</p>\
             <form method=\"post\" action=\"{PREFIX}/logout\"><button type=\"submit\">Sign out</button></form>",
            email = esc(auth.username()),
            roles = esc(&auth.claims.roles.join(", ")),
        );
        Ok(Html(layout("Your account", &body)).into_response())
    }

    /// Renews the session from the refresh cookie. The pages call it when a request comes
    /// back `401` (the access token expired while the page was open), then try again.
    #[karbon::post("/refresh")]
    async fn refresh(State(state): State<AppState>, headers: HeaderMap) -> AppResult<Response> {
        let renewed = match refresh_token_from(&headers) {
            Some(refresh_token) => auth::renew_session(&state, refresh_token).await.ok(),
            None => None,
        };
        Ok(match renewed {
            Some(session) => signed_in(&headers, &session, StatusCode::NO_CONTENT),
            None => signed_out(&headers, StatusCode::UNAUTHORIZED),
        })
    }

    #[karbon::post("/logout")]
    async fn logout(State(state): State<AppState>, headers: HeaderMap) -> AppResult<Response> {
        if let Some(refresh_token) = refresh_token_from(&headers) {
            auth::close_session(&state, refresh_token).await?;
        }
        Ok(signed_out(&headers, Redirect::to(&format!("{PREFIX}/login"))))
    }
}

/// `response`, with the two cookies of a session: the access token for every page, the
/// refresh token for the `/auth` routes only.
fn signed_in(headers: &HeaderMap, session: &Session, response: impl IntoResponse) -> Response {
    let secure = is_https(headers);
    let cookies = AppendHeaders([
        (SET_COOKIE, login_cookie(&session.access_token, session.expires_in, secure)),
        (SET_COOKIE, refresh_cookie(&session.refresh_token, session.refresh_expires_in, PREFIX, secure)),
    ]);
    (cookies, response).into_response()
}

/// `response`, with both session cookies removed.
fn signed_out(headers: &HeaderMap, response: impl IntoResponse) -> Response {
    let secure = is_https(headers);
    let cookies = AppendHeaders([
        (SET_COOKIE, logout_cookie(secure)),
        (SET_COOKIE, clear_refresh_cookie(PREFIX, secure)),
    ]);
    (cookies, response).into_response()
}

fn login_form(next: Option<&str>) -> Form {
    Form::new()
        .add(Field::email("email", "Email").required())
        .add(Field::password("password", "Password").required())
        .add(Field::hidden("next", next.unwrap_or_default()))
}

fn register_form() -> Form {
    Form::new()
        .add(Field::email("email", "Email").required().constraint(Email::new()))
        .add(Field::password("password", "Password").required().constraint(PasswordRule::new()))
}

fn forgot_form() -> Form {
    Form::new().add(Field::email("email", "Email").required())
}

fn reset_form(token: &str) -> Form {
    Form::new()
        .add(Field::password("password", "New password").required().constraint(PasswordRule::new()))
        .add(Field::hidden("token", token))
}

fn login_view(form: &Form, error: Option<&str>) -> Response {
    let body = format!(
        "{error}{form}<p class=\"hint\"><a href=\"{PREFIX}/forgot\">Forgot your password?</a></p>\
         <p class=\"hint\">No account yet? <a href=\"{PREFIX}/register\">Create one</a></p>",
        error = alert(error),
        form = form.render_form(&format!("{PREFIX}/login"), "Sign in"),
    );
    Html(layout("Sign in", &body)).into_response()
}

fn register_view(form: &Form, error: Option<&str>) -> Response {
    let body = format!(
        "{error}{form}<p class=\"hint\">{PASSWORD_HINT}</p>\
         <p class=\"hint\">Already registered? <a href=\"{PREFIX}/login\">Sign in</a></p>",
        error = alert(error),
        form = form.render_form(&format!("{PREFIX}/register"), "Create my account"),
    );
    Html(layout("Create an account", &body)).into_response()
}

fn forgot_view(form: &Form, error: Option<&str>) -> Response {
    let body = format!(
        "<p class=\"hint\">Enter the email of your account: we will send you a link to choose a new password.</p>\
         {error}{form}<p class=\"hint\"><a href=\"{PREFIX}/login\">Back to sign in</a></p>",
        error = alert(error),
        form = form.render_form(&format!("{PREFIX}/forgot"), "Send me the link"),
    );
    Html(layout("Forgot your password?", &body)).into_response()
}

fn reset_view(form: &Form, error: Option<&str>) -> Response {
    let again = if error == Some(BAD_RESET_LINK) {
        format!("<p class=\"hint\"><a href=\"{PREFIX}/forgot\">Ask for a new link</a></p>")
    } else {
        String::new()
    };
    let body = format!(
        "{error}{form}<p class=\"hint\">{PASSWORD_HINT}</p>{again}",
        error = alert(error),
        form = form.render_form(&format!("{PREFIX}/reset"), "Change my password"),
    );
    Html(layout("Choose a new password", &body)).into_response()
}

fn alert(message: Option<&str>) -> String {
    message.map(|m| format!("<p class=\"alert\">{}</p>", esc(m))).unwrap_or_default()
}

fn notice(message: &str) -> String {
    format!("<p class=\"notice\">{}</p>", esc(message))
}

fn esc(s: &str) -> String {
    s.replace('&', "&amp;").replace('<', "&lt;").replace('>', "&gt;").replace('"', "&quot;").replace('\'', "&#39;")
}

/// Page shell. The script posts forms with the CSRF token the middleware expects
/// (`X-CSRF-Token`, copied from the `csrf_token` cookie). If the answer is `401` — the
/// access token expired while the page was open — it renews the session and tries once
/// more. Then it follows the redirect, or shows the page that came back (the form with
/// its errors).
fn layout(title: &str, body: &str) -> String {
    format!(
        r#"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{t}</title>
<style>body{{font-family:system-ui,sans-serif;max-width:420px;margin:3rem auto;padding:0 1rem;color:#1a1a1a}}h1{{font-size:1.4rem}}.form-field{{margin:.75rem 0}}label{{display:block;font-weight:600;margin-bottom:.25rem}}input{{width:100%;padding:.55rem;border:1px solid #ccc;border-radius:6px;box-sizing:border-box}}.form-error{{color:#c0392b;font-size:.85rem;margin-top:.25rem}}.has-error input{{border-color:#c0392b}}button{{padding:.55rem 1rem;background:#111;color:#fff;border:0;border-radius:6px;cursor:pointer;font-size:.95rem}}.alert{{padding:.6rem .8rem;background:#fdecea;color:#a12622;border-radius:6px}}.notice{{padding:.6rem .8rem;background:#e8f5e9;color:#1e6b2b;border-radius:6px}}.hint{{color:#666;font-size:.9rem}}</style>
</head><body><h1>{t}</h1>{b}
<script>
document.addEventListener('submit', async function (e) {{
  var form = e.target;
  if ((form.getAttribute('method') || '').toLowerCase() !== 'post') return;
  e.preventDefault();
  function csrf() {{ var m = document.cookie.match(/csrf_token=([^;]+)/); return m ? m[1] : ''; }}
  function send() {{
    return fetch(form.getAttribute('action'), {{
      method: 'POST',
      headers: {{ 'X-CSRF-Token': csrf(), 'Content-Type': 'application/x-www-form-urlencoded' }},
      body: new URLSearchParams(new FormData(form)),
      redirect: 'follow'
    }});
  }}
  var res = await send();
  if (res.status === 401) {{
    var renewed = await fetch('/auth/refresh', {{ method: 'POST', headers: {{ 'X-CSRF-Token': csrf() }} }});
    if (renewed.ok) res = await send();
  }}
  if (res.redirected) {{ window.location = res.url; return; }}
  var html = await res.text();
  document.open(); document.write(html); document.close();
}});
</script>
</body></html>"#,
        t = esc(title),
        b = body
    )
}

// ─── JSON API ───

#[derive(Deserialize)]
pub struct Credentials {
    email: String,
    password: String,
}

#[derive(Deserialize)]
pub struct RefreshRequest {
    refresh_token: String,
}

#[derive(Deserialize)]
pub struct ForgotRequest {
    email: String,
}

#[derive(Deserialize)]
pub struct ResetRequest {
    token: String,
    password: String,
}

/// What a client keeps: `token` goes in `Authorization: Bearer …`; `refresh_token` buys
/// the next pair at `POST /auth/refresh` once `token` has expired.
#[derive(Serialize)]
pub struct TokenResponse {
    token: String,
    token_type: &'static str,
    /// Seconds until `token` expires (`JWT_EXPIRATION`).
    expires_in: i64,
    refresh_token: String,
}

impl From<Session> for TokenResponse {
    fn from(session: Session) -> Self {
        Self {
            token: session.access_token,
            token_type: "Bearer",
            expires_in: session.expires_in,
            refresh_token: session.refresh_token,
        }
    }
}

#[derive(Serialize)]
pub struct MessageResponse {
    message: &'static str,
}

pub struct AuthApiController;

#[karbon::controller(prefix = "/auth")]
impl AuthApiController {
    #[karbon::post("/login")]
    async fn login(State(state): State<AppState>, Json(body): Json<Credentials>) -> AppResult<Json<TokenResponse>> {
        let user = auth::authenticate(state.db.pool(), &body.email, &body.password).await?;
        Ok(Json(auth::open_session(&state, &user).await?.into()))
    }

    #[karbon::post("/register")]
    async fn register(State(state): State<AppState>, Json(body): Json<Credentials>) -> AppResult<Json<TokenResponse>> {
        auth::check_new_account(&body.email, &body.password)?;
        let user = auth::create_account(state.db.pool(), &body.email, &body.password).await?;
        Ok(Json(auth::open_session(&state, &user).await?.into()))
    }

    /// A refresh token works once: keep the new one from the answer.
    #[karbon::post("/refresh")]
    async fn refresh(
        State(state): State<AppState>,
        Json(body): Json<RefreshRequest>,
    ) -> AppResult<Json<TokenResponse>> {
        Ok(Json(auth::renew_session(&state, &body.refresh_token).await?.into()))
    }

    #[karbon::post("/logout")]
    async fn logout(State(state): State<AppState>, Json(body): Json<RefreshRequest>) -> AppResult<StatusCode> {
        auth::close_session(&state, &body.refresh_token).await?;
        Ok(StatusCode::NO_CONTENT)
    }

    /// Always the same answer: it must not tell whether the email has an account.
    #[karbon::post("/forgot")]
    async fn forgot(State(state): State<AppState>, Json(body): Json<ForgotRequest>) -> AppResult<Json<MessageResponse>> {
        auth::request_password_reset(&state, &body.email, &format!("{PREFIX}/reset")).await?;
        Ok(Json(MessageResponse { message: RESET_REQUESTED }))
    }

    #[karbon::post("/reset")]
    async fn reset(State(state): State<AppState>, Json(body): Json<ResetRequest>) -> AppResult<Json<MessageResponse>> {
        auth::check_password(&body.password)?;
        auth::reset_password(&state, &body.token, &body.password).await?;
        Ok(Json(MessageResponse { message: "Your password has been changed." }))
    }

    /// The account behind the token. `password` is skipped by the entity's serializer.
    #[karbon::get("/me")]
    async fn me(auth: AuthGuard, State(state): State<AppState>) -> AppResult<Json<User>> {
        let id = auth.user_id().ok_or_else(|| AppError::Unauthorized("This token names no user".into()))?;
        let user = User::find_by_id(state.db.pool(), id).await?;
        user.map(Json).ok_or_else(|| AppError::NotFound("This account no longer exists".into()))
    }
}
